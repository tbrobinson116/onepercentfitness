# DutySnap API Environment Configuration

# Server port
PORT=3001

# Classification Providers (configure at least one)
# The API supports A/B testing between multiple providers

# Zonos API - Specialized customs classification
# https://zonos.com/docs/supply-chain/classify
ZONOS_API_KEY=your_zonos_api_key

# Anthropic API - Claude vision classification
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI API - GPT-4 vision classification
# https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key

# Environment
NODE_ENV=development
