{
  "expo": {
    "name": "One Percent Fitness",
    "slug": "onepercent-fitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onepercentfitness.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take progress photos and scan food items",
        "NSPhotoLibraryUsageDescription": "Upload goal photos and progress pictures"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.onepercentfitness.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    }
  }
}
